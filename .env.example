# Example environment file for the Vibe Coding News Portal.
#
# Copy this to `.env.local` for local development:
#   cp .env.example .env.local
#
# NEVER commit real secrets. `.env*` files are gitignored except this example.
# Every variable is validated at runtime in src/config/env.ts.

# ---------------------------------------------------------------------------
# Core (Stage 2A)
# ---------------------------------------------------------------------------

# Node runtime mode: development | test | production
# Usually set automatically by the tooling; override only if you know why.
# NODE_ENV=development

# Deployment target: local | preview | production
# Distinct from NODE_ENV — a preview deploy still runs a production build.
APP_ENV=local

# Public application name (exposed to the browser bundle).
NEXT_PUBLIC_APP_NAME=Vibe Coding News Portal

# ---------------------------------------------------------------------------
# Database (Stage 2B)
# ---------------------------------------------------------------------------

# PostgreSQL / Supabase connection string used by the app, migrations, and seed.
# Optional: the app builds and boots without it, but database commands
# (db:migrate, db:seed, db:validate) require it.
#
# Local Postgres (with pgvector) example:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/vibecoding
# Supabase (pooled) example:
#   DATABASE_URL=postgres://postgres.<ref>:<password>@<host>:6543/postgres?sslmode=require
# DATABASE_URL=

# Optional direct (non-pooled) connection string. Supabase provides a direct URL
# better suited to running migrations; when unset, migrations use DATABASE_URL.
# DIRECT_URL=

# ---------------------------------------------------------------------------
# Admin & Editorial (Stage 4)
# ---------------------------------------------------------------------------
# The /admin surface is disabled until BOTH variables below are set. The app
# still builds and boots without them. See docs/ADMIN.md.

# Secret used to sign admin session cookies. Server-only; NEVER commit a real
# value. Must be at least 32 characters in production.
#   Generate one, e.g.:  openssl rand -hex 32
# ADMIN_SESSION_SECRET=

# Admin roster as a JSON array of { username, passwordHash, role? }.
# Passwords are stored ONLY as scrypt hashes — generate one with:
#   npm run admin:hash -- 'your-password'
# Roles: ADMIN | EDITOR (may mutate) | VIEWER (read-only). Defaults to ADMIN.
# ADMIN_USERS=[{"username":"alice","passwordHash":"scrypt:16384:8:1:<salt>:<hash>","role":"ADMIN"}]

# ---------------------------------------------------------------------------
# AI enrichment (Stage 6)
# ---------------------------------------------------------------------------
# AI is OPTIONAL. With none of these set, ingestion, admin, and public rendering
# work unchanged and the admin "Run AI enrichment" control is hidden. All values
# are server-only and never exposed to the browser or embedded in a prompt.
# See docs/ARCHITECTURE.MD (AI Architecture) and docs/ADMIN.md.

# Provider selection: fake | anthropic
#   fake      — deterministic in-memory provider (local smoke; no network, no key)
#   anthropic — live Anthropic Messages API adapter (requires AI_API_KEY + AI_MODEL)
# AI_PROVIDER=fake

# Server-only API key for the live provider. NEVER commit a real value.
# AI_API_KEY=

# Model identifier passed to the provider (e.g. a claude-* model id).
# AI_MODEL=

# Optional base-URL override for a compatible endpoint / proxy.
# AI_BASE_URL=
