# Example environment file for the Vibe Coding News Portal.
#
# Copy this to `.env.local` for local development:
#   cp .env.example .env.local
#
# NEVER commit real secrets. `.env*` files are gitignored except this example.
# Every variable is validated at runtime in src/config/env.ts.

# ---------------------------------------------------------------------------
# Core (Stage 2A)
# ---------------------------------------------------------------------------

# Node runtime mode: development | test | production
# Usually set automatically by the tooling; override only if you know why.
# NODE_ENV=development

# Deployment target: local | preview | production
# Distinct from NODE_ENV — a preview deploy still runs a production build.
APP_ENV=local

# Public application name (exposed to the browser bundle).
NEXT_PUBLIC_APP_NAME=Vibe Coding News Portal

# ---------------------------------------------------------------------------
# Database (Stage 2B)
# ---------------------------------------------------------------------------

# PostgreSQL / Supabase connection string used by the app, migrations, and seed.
# Optional: the app builds and boots without it, but database commands
# (db:migrate, db:seed, db:validate) require it.
#
# Local Postgres (with pgvector) example:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/vibecoding
# Supabase (pooled) example:
#   DATABASE_URL=postgres://postgres.<ref>:<password>@<host>:6543/postgres?sslmode=require
# DATABASE_URL=

# Optional direct (non-pooled) connection string. Supabase provides a direct URL
# better suited to running migrations; when unset, migrations use DATABASE_URL.
# DIRECT_URL=

# ---------------------------------------------------------------------------
# Reserved for later stages (do NOT populate yet)
# ---------------------------------------------------------------------------
# AI providers (Stage 6): e.g. AI provider API keys
